{
  "name": "@agentics/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentics": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root . --config ../../vitest.package.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "cli": "tsx src/index.ts",
    "coverage": "vitest run --root . --config ../../vitest.package.config.ts --coverage"
  },
  "dependencies": {
    "@agentics/agentics": "0.1.0",
    "@agentics/core": "0.1.0",
    "commander": "^13.1.0"
  }
}
