{
  "name": "@agentics/agentics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./src/context.ts",
      "default": "./dist/context.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --root . --config ../../vitest.package.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "coverage": "vitest run --root . --config ../../vitest.package.config.ts --coverage"
  },
  "dependencies": {
    "@agentics/ai": "0.1.0",
    "@agentics/github": "0.1.0",
    "@coderrob/typescript-type-guards": "^1.0.1"
  }
}
