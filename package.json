{
  "description": "Agentics monorepo for workflow orchestration, refinement, and optimization.",
  "devDependencies": {
    "@coderrob/eslint-plugin-zero-tolerance": "^1.2.4",
    "@types/node": "^22.15.3",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jscpd": "^4.0.9",
    "knip": "^6.6.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "license": "Apache-2.0",
  "name": "agentics-monorepo",
  "packageManager": "npm@10.9.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "circular": "madge --circular --extensions ts apps/cli/src packages/agentics/src packages/ai/src packages/core/src packages/github/src",
    "cli": "npm run cli:build && npm run cli:run --",
    "cli:build": "npm run build",
    "cli:run": "node apps/cli/dist/index.js",
    "coverage": "turbo run coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "github:aw:install": "gh extension install github/gh-aw",
    "github:aw:version": "gh aw version",
    "github:cli:version": "gh --version",
    "jscpd": "jscpd",
    "knip": "knip",
    "lint": "npm run lint:es && npm run lint:md",
    "lint:es": "eslint . --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#tendril\" \"#tendril/**\" \"#**/*.lock.yml\"",
    "quality": "npm run typecheck && npm run lint && npm test && npm run coverage && npm run circular && npm run knip && npm run jscpd && npm run format:check",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "workflows:compile": "npm run cli -- workflows compile --directory ../../workflows"
  },
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
